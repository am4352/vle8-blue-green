
pipeline {
    agent any

    environment {
        BLUE_PORT  = '8081'
        GREEN_PORT = '8082'
        APP_NAME   = 'vle8-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out.'
            }
        }

        stage('Validate') {
            steps {
                sh '''
                    test -f app/Dockerfile
                    test -f app/index.html
                    echo "Source validation passed."
                '''
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    sh '''
                        docker build \
                          -t ${APP_NAME}:${BUILD_NUMBER} \
                          -t ${APP_NAME}:latest .
                    '''
                }
            }
        }

       
stage('Detect Active Environment') {
    steps {
        script {
            def activePort = sh(
                script: "sudo grep -oE 'proxy_pass http://127\\.0\\.0\\.1:[0-9]+' /etc/nginx/conf.d/blue-green.conf | grep -oE '[0-9]+' | tail -1",
                returnStdout: true
            ).trim()

            if (activePort == '8081') {
                env.TARGET_PORT = '8082'
                env.TARGET_NAME = 'green'
            } else if (activePort == '8082') {
                env.TARGET_PORT = '8081'
                env.TARGET_NAME = 'blue'
            } else {
                error("Unexpected Nginx upstream port: ${activePort}")
            }

            echo "Currently active port: ${activePort}"
            echo "Deploying to inactive environment: ${env.TARGET_NAME} (${env.TARGET_PORT})"
        }
    }
}


        stage('Deploy to Inactive Environment') {
            steps {
                sh '''
                    docker rm -f ${TARGET_NAME} 2>/dev/null || true

                    docker run -d \
                      --name ${TARGET_NAME} \
                      --restart unless-stopped \
                      -p 127.0.0.1:${TARGET_PORT}:80 \
                      ${APP_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    set -e

                    for attempt in $(seq 1 10); do
                        if curl -fsS \
                          http://127.0.0.1:${TARGET_PORT}/ \
                          -o /tmp/vle8-health.html; then
                            echo "Health check passed on port ${TARGET_PORT}."
                            exit 0
                        fi

                        echo "Waiting for ${TARGET_NAME}..."
                        sleep 2
                    done

                    echo "Health check failed. Traffic will not be switched."
                    exit 1
                '''
            }
        }

        stage('Switch Traffic') {
            steps {
                sh 'sudo /usr/local/bin/vle8-switch ${TARGET_PORT}'
            }
        }

        stage('Verify Live Application') {
            steps {
                sh '''
                    set -e
                    curl -fsS http://127.0.0.1/ -o /dev/null
                    echo "Live application is responding successfully."
                '''
            }
        }
    }

    post {
        success {
            echo "Blue-Green deployment succeeded. Traffic is now routed to ${TARGET_NAME}."
        }

        failure {
            echo 'Deployment failed. Review the stage logs; the traffic switch is performed only after the health check.'
        }

        always {
            echo 'Pipeline execution complete.'
        }
    }
}
