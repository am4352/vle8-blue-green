pipeline {
    agent any

    environment {
        APP_NAME     = 'vle8-app'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        DOCKER_IMAGE = "${APP_NAME}:${IMAGE_TAG}"
        CONTAINER_PORT = '8083'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Lint & Validate') {
            steps {
                echo 'Validating Dockerfile and source files...'
                sh '''
                    # Basic Dockerfile syntax and presence check
                    test -f app/Dockerfile || exit 1
                    test -f app/index.html || exit 1
                    echo "Source files validated successfully."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${DOCKER_IMAGE}..."
                dir('app') {
                    sh "docker build -t ${DOCKER_IMAGE} -t ${APP_NAME}:latest ."
                }
            }
        }

       
stage('Container Smoke Test') {
    steps {
        echo 'Running smoke test on built container...'
        sh '''
            docker rm -f ${APP_NAME}-test 2>/dev/null || true

            docker run -d \
                --name ${APP_NAME}-test \
                -p 127.0.0.1:${CONTAINER_PORT}:80 \
                ${APP_NAME}:latest

            trap 'docker rm -f ${APP_NAME}-test >/dev/null 2>&1 || true' EXIT

            sleep 3

            curl -sSf \
                http://127.0.0.1:${CONTAINER_PORT}/ \
                > /dev/null

            echo "Health check passed!"
        '''
    }
}


stage('Deploy') {
    steps {
        echo 'Deploying application behind Nginx...'
        sh '''
            # Remove any previous application container
            docker rm -f ${APP_NAME}-prod 2>/dev/null || true

            # Run on an unused localhost port.
            # Nginx must be configured to proxy to this port
            # before this container is used for live traffic.
            docker run -d \
                --name ${APP_NAME}-prod \
                -p 127.0.0.1:8084:80 \
                --restart unless-stopped \
                ${DOCKER_IMAGE}

            # Verify the container responds
            sleep 3
            curl -sSf http://127.0.0.1:8084/ -o /dev/null

            echo "Application container is healthy on port 8084."
        '''
    }
}

    }

    post {
        always {
            echo 'Pipeline execution complete.'
        }
        success {
            echo "Build and Deployment completed successfully for build #${BUILD_NUMBER}!"
        }
        failure {
            echo "Pipeline failed on build #${BUILD_NUMBER}. Please check logs."
        }
    }
}
